{
  "expo": {
    "name": "Wenzee",
    "slug": "wenzee",
    "scheme": "wenzee",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FDF7F0",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.wenzee.mobile"
    },
    "android": {
      "package": "app.wenzee.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#7A1F0E"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#7A1F0E"
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/images/icon.png"
  }
}
